{
  "name": "devosfera",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "predev": "pnpm run fonts:subset",
    "fonts:subset": "python scripts/subset-font.py",
    "fonts:verify": "python scripts/subset-font.py --check",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:verify": "node scripts/optimize-images.mjs --check",
    "performance:verify": "node scripts/verify-performance-budget.mjs",
    "build": "pnpm run fonts:subset && astro check && astro build && node scripts/optimize-images.mjs && pagefind --site dist && node -e \"require('fs').cpSync('dist/pagefind','public/pagefind',{recursive:true})\"",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "new-md-post": "node scripts/new-md-post.js",
    "new-mdx-post": "node scripts/new-mdx-post.js",
    "update-mod-time": "node scripts/update-mod-time.js"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/devicon": "^1.2.66",
    "@iconify-json/lucide": "^1.2.135",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify/react": "^6.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.3",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.23",
    "katex": "^0.18.7",
    "lodash.kebabcase": "^4.1.1",
    "mdast-util-to-string": "^4.0.0",
    "prop-types": "^15.8.1",
    "react": "19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.6",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-directive": "^4.0.0",
    "remark-github-alerts": "^0.1.1",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/mdast": "^4.0.4",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-parse": "^11.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unified": "^11.0.5"
  }
}
