---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getEntryPath } from "@/utils/contentEntry";
import { getReadingTime } from "@/utils/readingTime";
import Datetime from "./Datetime.astro";
import IconProject from "@/assets/icons/IconProject.svg";
import IconClock from "@/assets/icons/IconClock.svg";
import { SITE } from "@/config";

type Props = {
  variant?: "h2" | "h3";
  featured?: boolean;
} & (CollectionEntry<"blog"> | CollectionEntry<"projects">);

const { variant: Heading = "h2", featured = false, id, data, filePath, collection, body } = Astro.props;

const { title, description, pubDatetime } = data;
const modDatetime = "modDatetime" in data ? data.modDatetime : null;
const timezone = "timezone" in data ? data.timezone : undefined;
const tags = "tags" in data ? data.tags : [];
const draft = "draft" in data ? data.draft : false;
const href = getEntryPath({ collection, id, filePath });
const isProject = collection === "projects";
const headingId = `${collection}-${slugifyStr(String(id))}-title`;
const descriptionId = `${collection}-${slugifyStr(String(id))}-description`;
const viewTransitionName = slugifyStr(String(title).replaceAll(".", "-"));
const readingTime = body ? getReadingTime(body) : null;

// Resolve cover image source. Local frontmatter images go through Astro's
// responsive transformer; generated OG URLs keep the plain-img fallback.
let coverImage: ImageMetadata | undefined;
let coverSrc: string | undefined;
if (SITE.showCoverImages) {
  if (isProject) {
    const d = data as {
      ogImage?: ImageMetadata | string;
      coverImage?: ImageMetadata;
    };
    if (d.ogImage) {
      if (typeof d.ogImage === "string") {
        coverSrc = d.ogImage;
      } else {
        coverImage = d.ogImage;
        coverSrc = d.ogImage.src;
      }
    } else if (d.coverImage) {
      coverImage = d.coverImage;
      coverSrc = d.coverImage.src;
    } else if (SITE.dynamicOgImage) {
      coverSrc = href + "/og.png";
    }
  } else {
    // Blog posts: prefer frontmatter ogImage, fallback to dynamic OG image
    if ("ogImage" in data && data.ogImage) {
      const ogImage = data.ogImage as ImageMetadata | string;
      if (typeof ogImage === "string") {
        coverSrc = ogImage;
      } else {
        coverImage = ogImage;
        coverSrc = ogImage.src;
      }
    } else if (SITE.dynamicOgImage) {
      // Fallback: dynamically generated OG image (exists in dist/ after pnpm build)
      coverSrc = href + "/index.png";
    }
  }
 }
---

<li
  data-has-cover={coverSrc ? "true" : "false"}
  class:list={[
    "card-glow group/card relative my-3 rounded-2xl",
    // Use overflow-hidden when cover image is shown so the image respects border-radius
    coverSrc ? "overflow-hidden" : "",
    "border backdrop-blur-sm",
    "transition-[border-color,background-color,box-shadow,transform] duration-300 ease-out motion-reduce:transform-none motion-reduce:transition-none",
    "hover:-translate-y-0.5 focus-within:-translate-y-0.5",
    "hover:shadow-lg focus-within:shadow-lg",

    // Default posts styling
    !isProject && !featured && [
      "border-border/25 bg-muted/10",
      "hover:border-accent/40 hover:bg-accent/5 focus-within:border-accent/40 focus-within:bg-accent/5",
      "hover:shadow-accent/10 focus-within:shadow-accent/10",
    ],

    // Featured generic posts styling
    !isProject && featured && [
      "border-accent/30 bg-accent/5",
      "hover:border-accent/50 hover:bg-accent/10 focus-within:border-accent/50 focus-within:bg-accent/10",
      "hover:shadow-accent/10 focus-within:shadow-accent/10",
      "shadow-accent/10",
    ],

    // Project variant styling
    isProject && !featured && [
      "border-highlight/20 bg-highlight/5",
      "hover:border-highlight/40 hover:bg-highlight/10 focus-within:border-highlight/40 focus-within:bg-highlight/10",
      "hover:shadow-highlight/10 focus-within:shadow-highlight/10",
    ],

    // Featured project styling
    isProject && featured && [
      "border-highlight/40 bg-highlight/10",
      "hover:border-highlight/60 hover:bg-highlight/15 focus-within:border-highlight/60 focus-within:bg-highlight/15",
      "hover:shadow-highlight/20 focus-within:shadow-highlight/20",
      "shadow-highlight/10",
    ],
  ]}
>
  <!-- Cursor-following glow -->
  <div
    class="card-glow-effect pointer-events-none absolute inset-0 z-0 rounded-2xl opacity-0 transition-opacity duration-300 motion-reduce:transition-none group-hover/card:opacity-100 group-focus-within/card:opacity-100"
    aria-hidden="true"
  >
  </div>

  <!-- Cover image — wrapped in <a> for clickability; aria-hidden so screen readers skip the duplicate link -->
  {coverSrc && (
    <a href={href} tabindex="-1" aria-hidden="true" class="card-cover-wrapper block" data-cover>
      {coverImage ? (
        <Image
          src={coverImage}
          alt=""
          class="card-cover-img"
          loading="lazy"
          widths={[400, 800]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
          format="webp"
        />
      ) : (
        <img
          src={coverSrc}
          alt=""
          class="card-cover-img"
          loading="lazy"
          decoding="async"
          onerror="this.closest('[data-cover]').style.display='none'"
        />
      )}
      <div class="card-cover-overlay" aria-hidden="true"></div>
    </a>
  )}

  <div class="card-content relative z-5 p-4 sm:p-5">
    <a
      href={href}
      class:list={[
        "card-link",
        "text-lg font-semibold text-foreground transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-sm",
        isProject
          ? "group-hover/card:text-highlight focus-visible:ring-highlight"
          : featured
            ? "group-hover/card:text-accent focus-visible:ring-accent"
            : "group-hover/card:text-accent focus-visible:ring-accent"
      ]}
      aria-labelledby={headingId}
      aria-describedby={descriptionId}
      style={{ viewTransitionName }}
    >
      <Heading id={headingId} class="card-title flex items-center gap-2">
        {isProject && (
          <span
            aria-hidden="true"
            class="inline-flex items-center justify-center rounded-md bg-highlight/10 p-1 text-highlight/80 ring-1 ring-highlight/20"
          >
            <IconProject class="size-4" />
          </span>
        )}
        {isProject && <span class="sr-only">Project:</span>}
        <span class="card-title-text">{title}</span>
      </Heading>
      <!-- Expand clickable area to whole card on top of everything, minus the description -->
      <span class="absolute -inset-4 sm:-inset-5 z-10" aria-hidden="true"></span>
    </a>
    
    <!-- Meta row: date + reading time + draft -->
    <div class="card-meta relative z-20 mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 pointer-events-none">
      <Datetime
        pubDatetime={pubDatetime}
        modDatetime={modDatetime}
        timezone={timezone}
        class="card-datetime"
      />
      {readingTime && (
        <span class="flex items-center gap-1 text-sm text-muted-foreground whitespace-nowrap">
          <IconClock class="size-4 shrink-0" aria-hidden="true" />
          {readingTime}
        </span>
      )}
      {draft && (
        <span class="card-draft flex items-center gap-1 rounded-md border border-accent/30 bg-accent/10 px-1.5 py-0.5 font-firacode text-xs text-accent-foreground whitespace-nowrap">
          <svg class="size-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
          </svg>
          Draft
        </span>
      )}
    </div>

    <p
      id={descriptionId}
      class="card-description relative z-20 mt-2 line-clamp-2 text-sm leading-relaxed text-foreground/75 pointer-events-auto select-text"
    >
      {description}
    </p>

    <!-- Tags -->
    {SITE.showTagsInCards && tags.length > 0 && (
      <ul class="card-tags relative z-20 mt-3 flex flex-wrap gap-1.5 pointer-events-auto">
        {tags.slice(0, 4).map((tag: string) => (
          <li>
            <a
              href={`/tags/${slugifyStr(tag)}/`}
              class:list={[
                "inline-flex items-center gap-0.5 rounded-full px-2.5 py-1 min-h-6",
                "text-xs font-medium",
                "border transition-colors duration-200",
                isProject
                  ? "border-highlight/25 bg-highlight/8 text-highlight/80 hover:border-highlight/50 hover:bg-highlight/15 hover:text-highlight"
                  : featured
                      ? "border-accent/25 bg-accent/8 text-accent/80 hover:border-accent/50 hover:bg-accent/15 hover:text-accent"
                      : "border-border/30 bg-muted/15 text-muted-foreground hover:border-accent/40 hover:bg-accent/10 hover:text-accent",
              ]}
            >
              <span aria-hidden="true" class="opacity-60">#</span>{tag}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</li>

<style>
  .card-glow {
    contain: paint;
  }

  .card-glow-effect {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      color-mix(in oklab, var(--accent) 8%, transparent) 0%,
      color-mix(in oklab, var(--accent) 4%, transparent) 30%,
      color-mix(in oklab, var(--accent) 0.8%, transparent) 60%,
      transparent 80%
    );
    will-change: opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-glow-effect {
      background: none;
    }
  }

  /* ── Cover image ── */
  .card-cover-wrapper {
    position: relative;
    width: 100%;
    /* 1200/630 OG aspect ratio */
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    /* Clamp height so tall viewports don't blow up the card */
    max-height: 220px;
  }

  @media (max-width: 639px) {
    .card-glow {
      /* Row spacing on mobile comes from the list's own `gap-3` (grid-cols-1),
         not this margin — stacking both would double the gap. */
      margin-block: 0;
    }

    .card-glow[data-has-cover="true"] {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      column-gap: 1rem;
      align-items: start;
      /* Pin the row to a fixed height instead of letting either side derive
         it from the other (text content or the source image's own aspect
         ratio). 7.5rem comfortably fits the worst case — 1-line title +
         meta row + 2-line description, all clamped — so in practice every
         has-cover row renders at exactly this height, and the image below
         is set to the same literal value, so it always fills it exactly. */
      min-height: 7.5rem;
    }

    .card-cover-wrapper {
      width: 4.5rem;
      max-height: none;
      aspect-ratio: auto;
    }

    .card-glow[data-has-cover="true"] .card-cover-wrapper {
      width: 7rem;
      height: 7.5rem;
      border-radius: 0;
    }

    .card-content {
      min-width: 0;
      padding: 0.875rem 1rem;
    }

    .card-glow[data-has-cover="true"] .card-content {
      padding: 0.875rem 1rem 0.875rem 0;
    }

    .card-link {
      font-size: 1rem;
    }

    .card-title-text {
      min-width: 0;
      display: block;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
      line-height: 1.35;
    }

    .card-meta {
      margin-top: 0.375rem;
      gap: 0.25rem 0.625rem;
      font-size: 0.75rem;
    }

    .card-meta :global(.card-datetime) {
      gap: 0.375rem;
    }

    .card-meta :global(.card-datetime svg) {
      width: 1rem;
      height: 1rem;
      min-width: 1rem;
    }

    .card-meta :global(.card-datetime time),
    .card-meta > span {
      font-size: 0.75rem;
    }

    .card-meta > span svg {
      width: 0.875rem;
      height: 0.875rem;
    }

    .card-meta .card-draft {
      gap: 0.25rem;
      padding: 0.125rem 0.375rem;
      font-size: 0.625rem;
    }

    .card-description {
      display: -webkit-box;
      margin-top: 0.375rem;
      overflow: hidden;
      font-size: 0.8125rem;
      line-height: 1.4;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .card-tags {
      display: none;
    }
  }

  .card-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    /* Subtle zoom on hover via the parent group */
    transition: transform 0.4s ease, filter 0.4s ease;
    filter: brightness(0.95) saturate(1.05);
  }

  :global(.group\/card:hover) .card-cover-img,
  :global(.group\/card:focus-within) .card-cover-img {
    transform: scale(1.03);
    filter: brightness(1) saturate(1.1);
  }

  /* Fade-to-card-background gradient at the bottom of the cover */
  .card-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      color-mix(in oklab, var(--background) 60%, transparent) 100%
    );
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-cover-img {
      transition: none;
    }
  }
</style>
